# DistroSim — Environment Variables
# Copy to .env and fill in API keys (all optional — system uses free APIs + benchmarks without them)

# ── Optional paid API keys ────────────────────────────────────────────────────
# Freightos API — live ocean/air freight rates (requires business account)
FREIGHTOS_API_KEY=

# EasyShip API — live last-mile rates (free tier available at easyship.com)
EASYSHIP_API_KEY=

# Dutify API — live customs duty rates (dutify.com)
DUTIFY_API_KEY=

# Descartes API — comprehensive tariff/HS classification data (enterprise)
DESCARTES_API_KEY=

# WTO API key — optional (increases rate limit for WTO Tariff API)
WTO_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Override backend URL (default: http://localhost:8000)
NUXT_PUBLIC_API_BASE=http://localhost:8000
